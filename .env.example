# --- Platform ---
# Root host. Businesses live at <slug>.<this>; the platform's own site at the root.
# Local dev: localhost:3000 (businesses at http://<slug>.localhost:3000).
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
# The platform's brand name (only shown on the platform's own site, never on a business's).
NEXT_PUBLIC_PLATFORM_NAME=TrainerOS
# Comma-separated emails that get platform admin (/admin) on sign-in.
PLATFORM_ADMIN_EMAILS=you@example.com
# Serve this business on hosts that aren't the platform's (e.g. *.vercel.app previews). Optional.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=

# Plans: Starter = $0/month + this fee on client payments (basis points; 300 = 3%).
PLATFORM_STARTER_FEE_BPS=300
# Pro = flat monthly price, 0% platform fee.
PLATFORM_PRO_PRICE_DOLLARS=49
# Optional: bill Pro with an existing Stripe Price (platform account). Otherwise one is created on first upgrade.
PLATFORM_PRO_PRICE_ID=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only (service role)

# --- Stripe (the platform's account, with Connect enabled) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...              # endpoint for events on your (platform) account
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...      # endpoint for events on connected accounts
STRIPE_AUTOMATIC_TAX=false                   # true once Stripe Tax is configured

# --- Email (Resend). Without a key, emails (sign-in links included) are logged to the console. ---
RESEND_API_KEY=
# Address on your Resend-verified domain; the display name is each business's name.
EMAIL_FROM_ADDRESS=notifications@example.com

# --- Custom domains (Vercel REST API). Without these, the settings page shows manual DNS steps. ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=                              # only for projects owned by a team

# --- Leads: signs download / unsubscribe tokens ---
LEAD_TOKEN_SECRET=change-me

# --- Video calls: "jitsi" (free, no setup) or "daily" (needs DAILY_API_KEY) ---
VIDEO_PROVIDER=jitsi
DAILY_API_KEY=

# --- Cron (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=change-me

# --- SMS reminders (Twilio). Without these, texts are logged to the console. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...                     # or use a Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=
