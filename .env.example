# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="HYPE by Summer"
# Trainer whose storefront the homepage shows (trainer_profiles.slug).
NEXT_PUBLIC_PRIMARY_TRAINER_SLUG=summer

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only (service role)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_AUTOMATIC_TAX=false                   # true once Stripe Tax is configured

# --- Email (Resend). Without a key, emails are logged to the console. ---
RESEND_API_KEY=
EMAIL_FROM="HYPE by Summer <hello@example.com>"

# --- Video calls: "jitsi" (free, no setup) or "daily" (needs DAILY_API_KEY) ---
VIDEO_PROVIDER=jitsi
DAILY_API_KEY=

# --- Cron (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=change-me

# --- SMS reminders (Twilio). Without these, texts are logged to the console. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...                     # or use a Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=
